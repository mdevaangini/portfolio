// ──────────────────────────────────────────────────────────────────────
// ABOUT THIS FILE: schema.prisma
// The description of ALL database tables (one model = one table).
// Change it → `npx prisma migrate dev` updates the real tables → `npx prisma generate` updates the TypeScript code.
// ──────────────────────────────────────────────────────────────────────

// The description of our database tables, for Prisma.
// Prisma reads this file to generate the TypeScript client code.

// What to generate: a TypeScript client, written into api/generated/prisma
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Which kind of database we use. The address itself comes from prisma.config.ts.
datasource db {
  provider = "postgresql"
}

// One model = one table.
// Left: the name used in TypeScript code. @map / @@map: the real name in the database.
model Project {
  id           Int     @id @default(autoincrement())
  title        String
  summary      String
  description  String
  /// Shown as a filter chip on the site, e.g. "Payments". Optional for now.
  category     String?
  imageUrl     String? @map("image_url")
  liveUrl      String? @map("live_url")
  repoUrl      String? @map("repo_url")
  displayOrder Int     @default(0) @map("display_order")

  @@map("projects")
}

// One job in the Experience section. endDate empty = current job.
model Experience {
  id          Int       @id @default(autoincrement())
  title       String
  company     String
  /// Small note after the company, e.g. "formerly PureSoftware". Optional.
  companyNote String?   @map("company_note")
  location    String
  summary     String
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date

  @@map("experiences")
}

// A heading in the Skills section, e.g. "Frontend". One group has many skills.
model SkillGroup {
  id           Int     @id @default(autoincrement())
  name         String
  /// Core groups get the stronger blue chip on the site.
  isCore       Boolean @default(false) @map("is_core")
  displayOrder Int     @default(0) @map("display_order")
  skills       Skill[]

  @@map("skill_groups")
}

// One skill chip, e.g. "RxJS". Each skill belongs to one group.
model Skill {
  id           Int        @id @default(autoincrement())
  name         String
  displayOrder Int        @default(0) @map("display_order")
  groupId      Int        @map("group_id")
  group        SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("skills")
}

// A message a visitor sends through the Contact form on the site.
model Message {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(254)
  message   String   @db.VarChar(2000)
  /// Filled in by the database when the row is saved.
  createdAt DateTime @default(now()) @map("created_at")

  @@map("messages")
}

// ══ BLOG (milestone 2) ══════════════════════════════════════════════════
// Five tables: users + sessions (login), posts (the writing), tags + post_tags
// (labels). Column limits match the API checks, like Message above.

// Enums = a column that may only hold one of a fixed list of values.
// Role has one value for now; the column exists so more roles could come later.
enum Role {
  ADMIN

  @@map("user_role")
}

// A post is either a draft (only I see it) or published (everyone sees it).
enum PostStatus {
  DRAFT
  PUBLISHED

  @@map("post_status")
}

// Someone who can log in to /admin. In practice one row: me.
// Created by the `npm run create-admin` script, never through the website.
model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(254)
  /// Never the password itself: a scrambled "fingerprint" of it (scrypt hash).
  passwordHash String    @map("password_hash")
  role         Role      @default(ADMIN)
  /// Wrong passwords in a row. Too many → locked for a while (stops guessing).
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]
  posts        Post[]

  @@map("users")
}

// One row per logged-in browser (the "wristband"). Logging out deletes the row.
model Session {
  id        Int      @id @default(autoincrement())
  /// Only a hash of the cookie's token: a stolen database can't be used to log in.
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

// One blog post. Drafts may be half-empty; the API checks more before publishing.
model Post {
  id            Int        @id @default(autoincrement())
  title         String     @db.VarChar(150)
  /// The post's address: /blog/<slug>. Lowercase letters, digits and "-".
  slug          String     @unique @db.VarChar(80)
  excerpt       String     @default("") @db.VarChar(300)
  /// The text, written in Markdown.
  content       String     @default("")
  coverImageUrl String?    @map("cover_image_url") @db.VarChar(500)
  status        PostStatus @default(DRAFT)
  /// Set the first time the post is published; kept if it's unpublished later.
  publishedAt   DateTime?  @map("published_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  /// Prisma updates this itself on every change.
  updatedAt     DateTime   @updatedAt @map("updated_at")
  authorId      Int        @map("author_id")
  author        User       @relation(fields: [authorId], references: [id])
  tags          PostTag[]

  // Speeds up the public list: "published posts, newest first".
  @@index([status, publishedAt])
  @@map("posts")
}

// A label like "angular" or "signals". Created on the fly from the editor.
model Tag {
  id    Int       @id @default(autoincrement())
  name  String    @unique @db.VarChar(30)
  /// Used in addresses: /blog?tag=<slug>
  slug  String    @unique @db.VarChar(40)
  posts PostTag[]

  @@map("tags")
}

// The JOIN table for many-to-many: one row = "this post has this tag".
// A post has many tags, and a tag is on many posts. Deleting a post (or tag)
// removes its rows here automatically (onDelete: Cascade).
model PostTag {
  postId Int  @map("post_id")
  tagId  Int  @map("tag_id")
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  // No id column: the pair (post, tag) is the key, so the same tag can't be added twice.
  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// ── My notes ────────────────────────────────────────────────────────────
// schema.prisma: the map of my database. Before `db pull` it had only the
// two setup blocks (generator and datasource); db pull added the model.
//
// How to read it:
// - model projects: one model = one table.
// - Each line = one column: name, then type.
// - String?: the ? means optional (columns created without NOT NULL).
// - @id: the primary key. @default(...): a value the database fills in itself.
