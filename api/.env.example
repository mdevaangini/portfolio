# Copy this file to ".env" and fill in real values.
# .env is never committed (see .gitignore); this example file is.

# Required: PostgreSQL connection string
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/portfolio

# Optional: defaults shown
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Optional: email me when someone sends the contact form (Resend).
# Leave empty to skip emails. The key is secret: never commit it.
RESEND_API_KEY=
NOTIFY_EMAIL=you@example.com
