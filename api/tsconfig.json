/*
 * ABOUT THIS FILE: tsconfig.json
 * TypeScript settings for the API. Used for type-checking and the editor;
 * tsx runs the code directly (no build step).
 */
{
  "compilerOptions": {
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "prisma.config.ts", "prisma/seed.ts", "vitest.config.ts"]
}
