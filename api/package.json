{
  "name": "api",
  "version": "1.0.0",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "vercel-build": "prisma generate && prisma migrate deploy",
    "start": "node dist/src/server.js",
    "start:local": "node --env-file=.env dist/src/server.js",
    "db:migrate": "prisma migrate deploy",
    "seed": "tsx --env-file=.env prisma/seed.ts",
    "create-admin": "tsx --env-file=.env scripts/create-admin.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "resend": "^6.34.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
