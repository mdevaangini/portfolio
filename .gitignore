# What Git must never save, for the whole project.
# (api/ and web/ also have their own .gitignore files; these rules add to them.)

# Installed packages: rebuilt with `npm install`
node_modules/

# Secrets: real passwords live only in .env files on this machine
.env
.env.*
!.env.example

# Generated or built output: always recreated by a command
api/generated/
api/dist/
web/dist/
web/.angular/

# Old, parked Prisma attempt (kept locally for reference only)
api/_prisma-backup/

# Editor and operating-system clutter
.DS_Store
Thumbs.db

# Copies the Claude app saves when it sends me a file in the chat
# (the real documents live in docs/)
Claude outputs/
